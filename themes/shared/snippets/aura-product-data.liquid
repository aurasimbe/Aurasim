{%- comment -%}
  JSON payload read by assets/aura.js for a product form.
  Usage: {% render 'aura-product-data', product: product %}
{%- endcomment -%}
{%- liquid
  assign color_index = -1
  assign size_index = -1
  for option in product.options_with_values
    assign oname = option.name | downcase
    if oname == 'color' or oname == 'colour' or oname == 'couleur'
      assign color_index = forloop.index0
    elsif oname == 'size' or oname == 'taille'
      assign size_index = forloop.index0
    endif
  endfor
-%}
<script type="application/json" data-product-json>
  {
    "colorIndex": {{ color_index }},
    "sizeIndex": {{ size_index }},
    "cartUrl": {{ routes.cart_url | json }},
    "strings": {
      "add": "Add to cart",
      "soldout": "Sold out",
      "unavailable": "Unavailable",
      "added": "Added — %s",
      "viewCart": "View cart",
      "error": "Something went wrong. Try again."
    },
    "variants": [
      {%- for v in product.variants -%}
        {
          "id": {{ v.id }},
          "available": {{ v.available | json }},
          "options": {{ v.options | json }},
          "price": {{ v.price | money | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
