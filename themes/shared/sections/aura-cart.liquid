<section class="aura a-cart" aria-labelledby="CartTitle-{{ section.id }}">
  <div class="a-wrap">
    {%- if cart.item_count > 0 -%}
      <div class="a-cart__head" data-reveal>
        <div>
          <p class="a-eyebrow">{{ section.settings.eyebrow }}</p>
          <h1 id="CartTitle-{{ section.id }}">{{ section.settings.title }}</h1>
        </div>
        <a class="a-link a-muted" href="{{ section.settings.continue_url | default: routes.all_products_collection_url }}">Continue shopping</a>
      </div>

      <form action="{{ routes.cart_url }}" method="post" id="AuraCart-{{ section.id }}" data-aura-cart novalidate>
        <div class="a-cart__grid">
          <div>
            {%- for item in cart.items -%}
              <div class="a-line" data-reveal>
                <a class="a-line__img" href="{{ item.url }}">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.product.title }}
                  {%- endif -%}
                </a>
                <div>
                  <a class="a-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
                  {%- unless item.product.has_only_default_variant -%}
                    <p class="a-line__meta">
                      {%- for option in item.options_with_values -%}
                        {%- if option.name == 'Color' or option.name == 'Colour' or option.name == 'Couleur' -%}
                          <span class="a-card__dot" style="background: {% render 'aura-hex', name: option.value %}"></span>
                        {%- endif -%}
                        {{ option.value }}{% unless forloop.last %} / {% endunless %}
                      {%- endfor -%}
                    </p>
                  {%- endunless -%}
                  <div class="a-qty">
                    <button type="button" data-qty-step="-1" aria-controls="Qty-{{ item.key | handleize }}" aria-label="Decrease quantity of {{ item.title | escape }}">−</button>
                    <input
                      type="number"
                      name="updates[]"
                      id="Qty-{{ item.key | handleize }}"
                      value="{{ item.quantity }}"
                      min="0"
                      aria-label="Quantity of {{ item.title | escape }}"
                    >
                    <button type="button" data-qty-step="1" aria-controls="Qty-{{ item.key | handleize }}" aria-label="Increase quantity of {{ item.title | escape }}">+</button>
                  </div>
                  <div><a class="a-line__remove" href="{{ item.url_to_remove }}">Remove</a></div>
                </div>
                <div class="a-line__price">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <s class="a-muted">{{ item.original_line_price | money }}</s><br>
                  {%- endif -%}
                  {{ item.final_line_price | money }}
                </div>
              </div>
            {%- endfor -%}
          </div>

          <aside class="a-summary" data-reveal data-reveal-delay="1">
            <p class="a-eyebrow" style="margin-bottom: 1rem">Summary</p>
            <div class="a-summary__row"><span>Subtotal</span><span>{{ cart.items_subtotal_price | money }}</span></div>
            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="a-summary__row"><span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
            {%- endfor -%}
            <div class="a-summary__row a-summary__row--total"><span>Total</span><span>{{ cart.total_price | money_with_currency }}</span></div>
            <p class="a-summary__note">{{ section.settings.note }}</p>
            {%- if section.settings.show_note -%}
              <label for="CartNote-{{ section.id }}" class="a-muted" style="font-size: .8rem">Order note</label>
              <textarea id="CartNote-{{ section.id }}" name="note">{{ cart.note }}</textarea>
            {%- endif -%}
            <button type="submit" name="checkout" class="a-btn a-btn--block">Checkout</button>
            {%- if additional_checkout_buttons and section.settings.show_dynamic -%}
              <div style="margin-top: 12px">{{ content_for_additional_checkout_buttons }}</div>
            {%- endif -%}
          </aside>
        </div>
      </form>
    {%- else -%}
      <div class="a-cart__empty" data-reveal>
        <p class="a-eyebrow">{{ section.settings.eyebrow }}</p>
        <h1 id="CartTitle-{{ section.id }}">{{ section.settings.empty_title }}</h1>
        <p class="a-muted">{{ section.settings.empty_text }}</p>
        <a class="a-btn" href="{{ section.settings.continue_url | default: routes.all_products_collection_url }}">Shop the drop</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "AURASIM — Cart",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "AURASIM — Cart" },
    { "type": "text", "id": "title", "label": "Title", "default": "Your bag" },
    { "type": "text", "id": "empty_title", "label": "Empty title", "default": "Nothing here yet" },
    { "type": "text", "id": "empty_text", "label": "Empty text", "default": "Your aura is waiting. Pick a color." },
    { "type": "text", "id": "note", "label": "Summary note", "default": "Shipping and taxes are calculated at checkout." },
    { "type": "url", "id": "continue_url", "label": "Continue shopping link" },
    { "type": "checkbox", "id": "show_note", "label": "Show order note", "default": false },
    { "type": "checkbox", "id": "show_dynamic", "label": "Show express checkout buttons", "default": true }
  ]
}
{% endschema %}
