<section class="aura s-collection" aria-labelledby="SCollTitle-{{ section.id }}" data-aura-filter>
  <div class="a-wrap">
    <header class="s-collection__head" data-reveal>
      <p class="a-eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 id="SCollTitle-{{ section.id }}">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="a-muted s-collection__desc">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- liquid
      assign all_colors = ''
      for p in collection.products
        assign copt = p.options_by_name['Color']
        if copt
          for value in copt.values
            assign cname = value | append: ''
            unless all_colors contains cname
              assign all_colors = all_colors | append: cname | append: '|'
            endunless
          endfor
        endif
      endfor
      assign color_list = all_colors | split: '|'
    -%}

    {%- if color_list.size > 1 -%}
      <div class="s-filters" role="group" aria-label="Filter by aura" data-reveal>
        <button type="button" class="s-filter is-active" data-filter="all" aria-pressed="true">All</button>
        {%- for cname in color_list -%}
          <button type="button" class="s-filter" data-filter="{{ cname }}" aria-pressed="false" style="--c: {% render 'aura-hex', name: cname %}">
            <span class="s-filter__sq"></span>{{ cname }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- paginate collection.products by 24 -%}
      <div class="s-collection__grid">
        {%- for p in collection.products -%}
          {%- assign copt = p.options_by_name['Color'] -%}
          {%- if copt -%}
            {%- assign ci = copt.position | minus: 1 -%}
            {%- for value in copt.values -%}
              {%- assign cname = value | append: '' -%}
              {%- liquid
                assign vid = p.selected_or_first_available_variant.id
                for v in p.variants
                  if v.options[ci] == cname
                    assign vid = v.id
                    break
                  endif
                endfor
              -%}
              <a class="a-card s-card" href="{{ p.url }}?variant={{ vid }}" data-filter-item="{{ cname }}" style="--c: {% render 'aura-hex', name: cname %}" data-reveal data-reveal-delay="{{ forloop.index0 | modulo: 3 }}">
                <div class="a-card__media">
                  {%- render 'aura-color-media', product: p, color: cname, index: 0, width: 900, sizes: '(min-width: 990px) 30vw, 50vw' -%}
                  {%- render 'aura-color-media', product: p, color: cname, index: 1, width: 900, sizes: '(min-width: 990px) 30vw, 50vw' -%}
                  <span class="s-card__tag">{{ cname }}</span>
                </div>
                <div class="a-card__info">
                  <span class="a-card__title">{{ p.title }}</span>
                  <span class="a-card__price">{{ p.price | money }}</span>
                </div>
              </a>
            {%- endfor -%}
          {%- else -%}
            <a class="a-card s-card" href="{{ p.url }}" data-filter-item="other" data-reveal>
              <div class="a-card__media">
                {%- if p.featured_media -%}
                  {{ p.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 30vw, 50vw', widths: '360, 540, 720, 900' }}
                {%- endif -%}
              </div>
              <div class="a-card__info">
                <span class="a-card__title">{{ p.title }}</span>
                <span class="a-card__price">{{ p.price | money }}</span>
              </div>
            </a>
          {%- endif -%}
        {%- else -%}
          <p class="a-muted">Nothing here yet. The drop is coming.</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="s-collection__pages" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "B — Collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop — Drop 01" }
  ]
}
{% endschema %}
